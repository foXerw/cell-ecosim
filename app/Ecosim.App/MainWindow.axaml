<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Ecosim.App.ViewModels"
        xmlns:core="using:Ecosim.Core"
        xmlns:ctrl="using:Ecosim.App.Controls"
        x:Class="Ecosim.App.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Cell Ecosim — 细胞生态模拟器"
        Width="1200" Height="800"
        WindowStartupLocation="CenterScreen">

  <DockPanel>

    <!-- 原生引擎加载失败 / ABI 版本不匹配时显示（见计划 Review Focus #1）。 -->
    <Border x:Name="ErrorPanel" DockPanel.Dock="Top" IsVisible="False"
            Background="#4A2020" BorderBrush="#8A3A3A" BorderThickness="0,0,0,1" Padding="12">
      <StackPanel Spacing="6">
        <TextBlock Text="无法启动模拟引擎" FontWeight="Bold" Foreground="#FFDDDD" />
        <TextBlock x:Name="ErrorText" Foreground="#FFD0D0" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <Border x:Name="ToolBar" DockPanel.Dock="Top" Padding="10,8" BorderThickness="0,0,0,1"
            BorderBrush="#2A2F36" Background="#1A1E23">
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button Content="▶ / ⏸ 播放" Command="{Binding ToggleRunCommand}" MinWidth="104" />
        <Button Content="⏭ 单步" Command="{Binding StepCommand}" MinWidth="80" />
        <Button Content="🎲 随机" Command="{Binding RandomizeCommand}" />
        <Button Content="🧹 清空" Command="{Binding ClearCommand}" />

        <TextBlock Text="模式" VerticalAlignment="Center" Opacity="0.75" />
        <ComboBox ItemsSource="{Binding ModeNames}" SelectedIndex="{Binding ModeIndex, Mode=TwoWay}"
                  MinWidth="140" ToolTip.Tip="切换会重建世界，活细胞会被带过去" />

        <TextBlock Text="速度(代/秒)" VerticalAlignment="Center" Opacity="0.75" />
        <NumericUpDown Value="{Binding Speed}" Minimum="1" Maximum="100000"
                       Increment="5" FormatString="0" Width="110" />

        <Button Content="＋" Command="{Binding ZoomInCommand}" ToolTip.Tip="放大" />
        <Button Content="－" Command="{Binding ZoomOutCommand}" ToolTip.Tip="缩小" />
        <Button Content="⤢ 适应" Command="{Binding FitViewCommand}" />

        <Button Content="📂 导入 RLE" Command="{Binding OpenRleCommand}" />
        <Button Content="💾 导出 RLE" Command="{Binding SaveRleCommand}" />
        <Button Content="🗄 打开 .cew" Command="{Binding OpenCewCommand}"
                ToolTip.Tip="读取完整世界状态：物种、能量、resource、参数与代数" />
        <Button Content="🗀 保存 .cew" Command="{Binding SaveCewCommand}"
                ToolTip.Tip="保存完整世界状态（生态模式请用这个，RLE 存不下物种）" />
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Padding="10,6" BorderThickness="0,1,0,0"
            BorderBrush="#2A2F36" Background="#1A1E23">
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <TextBlock Text="时间轴" VerticalAlignment="Center" Opacity="0.75" />
        <Slider x:Name="TimelineSlider" Width="360" Minimum="0"
                Maximum="{Binding Timeline.MaximumIndex}"
                Value="{Binding ScrubValue, Mode=OneWay}"
                ToolTip.Tip="拖动后松手回到那一代（会自动暂停）" />
        <TextBlock Text="{Binding ReviewLabel}" VerticalAlignment="Center"
                   FontFamily="Consolas,Menlo,monospace" />
        <Button Content="退出回放" Command="{Binding ExitReviewCommand}" />
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Padding="10,6" BorderThickness="0,1,0,0"
            BorderBrush="#2A2F36" Background="#1A1E23">
      <StackPanel Orientation="Horizontal" Spacing="18">
        <TextBlock Text="{Binding StatusText}" FontFamily="Consolas,Menlo,monospace" />
        <TextBlock x:Name="HoverText" Opacity="0.85" />
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Left" Width="230" Background="#171B20"
            BorderBrush="#2A2F36" BorderThickness="0,0,1,0" Padding="12">
      <ScrollViewer>
        <StackPanel Spacing="14">

          <StackPanel Spacing="6">
            <TextBlock Text="工具" FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button Content="✏ 画" Command="{Binding Canvas.SelectToolCommand}"
                      CommandParameter="{x:Static vm:CanvasTool.Draw}" />
              <Button Content="◌ 擦" Command="{Binding Canvas.SelectToolCommand}"
                      CommandParameter="{x:Static vm:CanvasTool.Erase}" />
              <Button Content="✋ 平移" Command="{Binding Canvas.SelectToolCommand}"
                      CommandParameter="{x:Static vm:CanvasTool.Pan}" />
            </StackPanel>
            <TextBlock Text="笔刷半径" Opacity="0.75" />
            <Slider Minimum="1" Maximum="32" Value="{Binding Canvas.BrushRadius}"
                    TickFrequency="1" IsSnapToTickEnabled="True" />
            <TextBlock Text="物种（M2 起多物种生效）" Opacity="0.75" />
            <NumericUpDown Value="{Binding Canvas.Species}" Minimum="1" Maximum="15"
                           FormatString="0" />
          </StackPanel>

          <StackPanel Spacing="6">
            <TextBlock Text="图案库" FontWeight="SemiBold" />
            <ListBox ItemsSource="{Binding Patterns}" SelectedItem="{Binding SelectedPattern}"
                     MaxHeight="150">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="core:Pattern">
                  <TextBlock Text="{Binding Name}" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <Button Content="⬇ 放置到中心" Command="{Binding ApplyPatternCommand}" />
          </StackPanel>

          <StackPanel Spacing="6">
            <TextBlock Text="叠加层" FontWeight="SemiBold" />
            <WrapPanel>
              <Button Content="物种" Command="{Binding Canvas.SelectLayerCommand}"
                      CommandParameter="{x:Static core:RenderLayer.Species}" Margin="0,0,6,6" />
              <Button Content="能量" Command="{Binding Canvas.SelectLayerCommand}"
                      CommandParameter="{x:Static core:RenderLayer.Energy}" Margin="0,0,6,6" />
              <Button Content="resource" Command="{Binding Canvas.SelectLayerCommand}"
                      CommandParameter="{x:Static core:RenderLayer.Resource}" Margin="0,0,6,6" />
              <Button Content="年龄" Command="{Binding Canvas.SelectLayerCommand}"
                      CommandParameter="{x:Static core:RenderLayer.Age}" />
            </WrapPanel>
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Text="参数（由引擎描述表生成）" FontWeight="SemiBold" />
            <ItemsControl ItemsSource="{Binding Params.Groups}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="core:ParamGroup">
                  <StackPanel Spacing="2" Margin="0,5,0,0">
                    <TextBlock Text="{Binding Section}" FontSize="12" Opacity="0.65" />
                    <ItemsControl ItemsSource="{Binding Sliders}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="core:ParamSlider">
                          <StackPanel Spacing="0">
                            <Grid ColumnDefinitions="*,Auto">
                              <TextBlock Text="{Binding Title}" FontSize="12" Opacity="0.85" />
                              <TextBlock Grid.Column="1" Text="{Binding Value, StringFormat={}{0:N0}}"
                                         FontSize="12" Opacity="0.6" />
                            </Grid>
                            <Slider Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                                    Value="{Binding Value}" SmallChange="{Binding Step}"
                                    LargeChange="{Binding Step}" />
                            <TextBlock Text="{Binding Error}" FontSize="11" Foreground="#FFB3B3"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <StackPanel Spacing="6">
            <TextBlock Text="规则 B / S" FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBox Text="{Binding BirthText}" Width="60" PlaceholderText="3" />
              <TextBox Text="{Binding SurviveText}" Width="60" PlaceholderText="23" />
              <Button Content="应用" Command="{Binding ApplyRuleCommand}" />
            </StackPanel>
            <Button Content="{Binding TopologyLabel, StringFormat='拓扑：{0}（点击切换）'}"
                    Command="{Binding ToggleTopologyCommand}" HorizontalAlignment="Stretch" />
          </StackPanel>

          <StackPanel Spacing="6">
            <TextBlock Text="新建世界" FontWeight="SemiBold" />
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" RowSpacing="4">
              <TextBlock Grid.Row="0" Grid.Column="0" Text="宽" VerticalAlignment="Center"
                         Margin="0,0,6,0" />
              <NumericUpDown Grid.Row="0" Grid.Column="1" Value="{Binding NewWidth}"
                             Minimum="16" Maximum="8192" FormatString="0" />
              <TextBlock Grid.Row="1" Grid.Column="0" Text="高" VerticalAlignment="Center"
                         Margin="0,0,6,0" />
              <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding NewHeight}"
                             Minimum="16" Maximum="8192" FormatString="0" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button Content="512" Tag="512" Click="OnPresetClick" />
              <Button Content="1024" Click="OnPresetClick" Tag="1024" />
              <Button Content="2048" Click="OnPresetClick" Tag="2048" />
              <Button Content="新建" Command="{Binding NewWorldCommand}" />
            </StackPanel>
          </StackPanel>

          <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" Opacity="0.8" />

        </StackPanel>
      </ScrollViewer>
    </Border>

    <Border DockPanel.Dock="Right" Width="250" Background="#171B20"
            BorderBrush="#2A2F36" BorderThickness="1,0,0,0" Padding="10">
      <StackPanel Spacing="8">
        <TextBlock Text="种群数量（最近 600 代）" FontWeight="SemiBold" />
        <ctrl:PopulationChart Samples="{Binding HistorySamples}" Height="150" />
        <StackPanel Orientation="Horizontal" Spacing="12">
          <TextBlock Text="■ 藻" Foreground="#6FD36F" FontSize="12" />
          <TextBlock Text="■ 虫" Foreground="#E8C840" FontSize="12" />
          <TextBlock Text="■ 兽" Foreground="#F06058" FontSize="12" />
        </StackPanel>

        <TextBlock Text="能量分布" FontWeight="SemiBold" Margin="0,10,0,0" />
        <ctrl:EnergyHistogramChart Values="{Binding Histogram}" Height="90" />

        <TextBlock Text="事件日志" FontWeight="SemiBold" Margin="0,10,0,0" />
        <ListBox ItemsSource="{Binding EventLines}" Height="240" FontSize="12"
                 Background="#14181D" BorderBrush="#2A2F36" />
      </StackPanel>
    </Border>

    <!-- 画布：一像素一格的位图，位置与尺寸来自 Viewport.DestinationRect -->
    <Grid x:Name="CanvasHost" ClipToBounds="True" Background="#0F1216"
          PointerPressed="OnCanvasPointerPressed"
          PointerMoved="OnCanvasPointerMoved"
          PointerReleased="OnCanvasPointerReleased"
          PointerWheelChanged="OnCanvasWheel">
      <!-- 位置与尺寸来自 Viewport.DestinationRect：绘制落点和点击反算用同一套数，
           不存在 Image 居中或 RenderTransform 原点带来的隐性偏移。 -->
      <Canvas>
        <Image x:Name="CanvasImage" Stretch="Fill"
               Canvas.Left="{Binding Canvas.CanvasLeft}"
               Canvas.Top="{Binding Canvas.CanvasTop}"
               Width="{Binding Canvas.CanvasWidth}"
               Height="{Binding Canvas.CanvasHeight}"
               RenderOptions.BitmapInterpolationMode="None" />
      </Canvas>
    </Grid>

  </DockPanel>
</Window>
