# Keep LF everywhere: bash scripts need it, and it stops git from rewriting
# every file on checkout on this Windows box.
* text=auto eol=lf
*.sh text eol=lf
*.rle text eol=lf
*.axaml text eol=lf
*.cs text eol=lf
*.csproj text eol=lf
*.props text eol=lf
*.slnx text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.c text eol=lf
*.cpp text eol=lf
*.txt text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.dll binary
*.exe binary
*.png binary
*.cew binary
